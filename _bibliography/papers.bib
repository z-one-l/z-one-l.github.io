@article{li2026irisflow,
  abbr        = {arXiv},
  bibtex_show = {true},
  title       = {Joint Discrete-Continuous Flow Matching for Open-Vocabulary Inverse Design of Multilayer Optical Coatings},
  author      = {Li, Zhiyi and Jin, Yuheng and Huang, Yidan and Chen, Nan and Fu, Hongyan and Bu, Yikun},
  journal     = {arXiv preprint arXiv:2607.08392},
  year        = {2026},
  arxiv       = {2607.08392},
  html        = {https://arxiv.org/abs/2607.08392},
  website     = {https://z-one-l.github.io/#irisflow},
  preview     = {irisflow.png},
  abstract    = {Neural inverse design promises to replace per-target optimization of multilayer optical coatings with a single trained model, but three closed-world assumptions built into current architectures block deployment: materials are learned as fixed vocabulary tokens, the wavelength grid is frozen at training time, and layer thicknesses are discretized. Here, IrisFlow, a joint discrete-continuous flow-matching framework, instead receives the design space itself as input. The target reflectance-transmittance spectrum, the wavelength grid, the candidate materials' optical constants, and the layer count all enter at inference time; material sequences and continuous thicknesses are generated jointly by coupled discrete and continuous flows, with no thickness quantization. Across a 224-task benchmark, a single 136-million-parameter model designs 2-100-layer stacks, holds same-order accuracy on 15 materials never seen in training, reconstructs spectral bands up to 1100 nm beyond its training envelope, reaches oblique-incidence and polarized targets through an input transformation alone, and outperforms an autoregressive baseline on that baseline's own material library. Designed against optical constants calibrated to the deposition chamber in which they are grown, four colored coolers fabricated by ion-assisted evaporation render their target colors while reflecting up to 95% of the solar near-infrared.},
  additional_info = {. First author, preprint under review},
  selected    = {true}
}
